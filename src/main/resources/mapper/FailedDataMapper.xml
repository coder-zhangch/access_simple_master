<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.mapper.FailedDataMapper">

    <resultMap id="failedMap" type="com.example.entity.FailedData">
        <id property="id" column="id"/>
        <result property="firstPushTime" column="推送时间"/>
    </resultMap>

    <select id="findByTime" resultMap="failedMap" parameterType="java.lang.String">
        SELECT * FROM FailedData where 推送时间 >= #{time}
    </select>

    <delete id="delete">
        delete from FailedData
    </delete>

    <delete id="deleteNotIn">
        delete from FailedData where id not in
        <foreach collection="list" item="item" open="(" separator="," close=")">
            #{item}
        </foreach>
    </delete>

    <insert id="insert">
        insert into FailedData(id, 推送时间) values
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.firstPushTime})
        </foreach>
    </insert>
</mapper>
